{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "backend": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["postgres", "bbolt"]
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "agentVersions": {
          "type": "object",
          "properties": {
            "clients": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["github", "bdot"],
                "description": "Valid values are 'github' or 'bdot'"
              },
              "description": "The agent versions clients source to use. Must contain only 'github' and/or 'bdot' values.",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      }
    },
    "nats": {
      "type": "object",
      "properties": {
        "deploymentType": {
          "type": "string",
          "enum": ["StatefulSet", "Deployment"],
          "description": "The type of NATS deployment, either StatefulSet or Deployment."
        }
      },
      "required": ["deploymentType"],
      "additionalProperties": true
    },
    "eventbus": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["", "nats", "pubsub", "kafka"],
          "description": "The type of event bus used. Must be one of '', 'nats', 'pubsub', or 'kafka'."
        }
      },
      "additionalProperties": true
    },
    "auth": {
      "type": "object",
      "properties": {
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string",
              "description": "The URL of the OIDC provider."
            },
            "oauth2ClientID": {
              "type": "string",
              "description": "Client ID to use when authenticating with the OIDC provider."
            },
            "oauth2ClientSecret": {
              "type": "string",
              "description": "Client secret to use when authenticating with the OIDC provider."
            },
            "oauth2ClientSecretRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Kubernetes secret name that contains the OIDC OAuth2 client secret."
                },
                "key": {
                  "type": "string",
                  "description": "The secret's subPath which contains the OAuth2 client secret."
                }
              },
              "additionalProperties": false
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "List of requested permissions."
            }
          },
          "required": ["issuer", "oauth2ClientID", "oauth2ClientSecret", "scopes"],
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "gsm": {
      "type": "object",
      "description": "Google Secret Manager (GSM) integration using GKE Secret Sync.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Render the SecretProviderClass and SecretSync resources."
        },
        "projectId": {
          "type": "string",
          "description": "Google Cloud project ID that contains the secrets. Required when gsm.enabled is true."
        },
        "spc": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Name of the SecretProviderClass. Defaults to <fullname>-gsm."
            },
            "secrets": {
              "type": "array",
              "description": "Secrets to fetch from Google Secret Manager.",
              "items": {
                "type": "object",
                "properties": {
                  "secretName": {
                    "type": "string",
                    "description": "Secret Manager secret name (not the full resource name).",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "path": {
                    "type": "string",
                    "description": "File name the secret is returned as. Referenced by gsm.secretsync.secretObject.data[].sourcePath.",
                    "minLength": 1
                  },
                  "version": {
                    "type": ["string", "integer"],
                    "description": "Secret version. Defaults to latest.",
                    "pattern": "^(latest|[1-9][0-9]*)$",
                    "minimum": 1
                  }
                },
                "required": ["secretName", "path"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "secretsync": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Render the SecretSync resource."
            },
            "name": {
              "type": "string",
              "description": "Name of the SecretSync and of the Kubernetes Secret it creates. Defaults to config.secret."
            },
            "serviceAccountName": {
              "type": "string",
              "description": "Kubernetes ServiceAccount used by the Secret Sync controller. Defaults to the chart's ServiceAccount."
            },
            "secretObject": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sourcePath": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[A-Za-z0-9.]([-A-Za-z0-9]+([-._a-zA-Z0-9]?[A-Za-z0-9])*)?(\\/([0-9]+))*$"
                      },
                      "targetKey": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[A-Za-z0-9.]([-A-Za-z0-9]+([-._a-zA-Z0-9]?[A-Za-z0-9])*)?(\\/([0-9]+))*$"
                      }
                    },
                    "required": ["sourcePath", "targetKey"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["type", "data"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["nats", "eventbus", "auth"],
  "additionalProperties": true
}
